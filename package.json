{
  "name": "acme-identity",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Thin local identity layer for Acme suite auth, roles, and principals",
  "license": "MIT",
  "author": "Ei Maung",
  "keywords": [
    "identity",
    "auth",
    "roles",
    "local",
    "acme",
    "experimental"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "acme-identity": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/client.js",
    "./client": "./dist/client.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc && tsc -p web/tsconfig.json && vite build",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "dev": "ACME_IDENTITY_DEV=1 tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "node --test --import tsx test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "audit": "npm audit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
